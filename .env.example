# Resend API key. Create one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact form submissions are delivered (comma-separate multiple addresses)
CONTACT_TO_EMAIL=you@YOUR-DOMAIN.com

# Optional: sender address. Must be on a domain you have verified in Resend.
# If omitted, Resend's test sender (onboarding@resend.dev) is used, which can
# only deliver to the email address on your Resend account.
CONTACT_FROM_EMAIL="Perilancers Website <hello@YOUR-DOMAIN.com>"

# Optional: Google Analytics 4 measurement ID. Analytics only loads when this is set.
NEXT_PUBLIC_GA_ID=
