# ─── Contact form ──────────────────────────────────────────────────────────────
# Configure at least one destination. If both are set, enquiries go to both.

# Option 1 (recommended to start): Google Sheet + email notification via Apps Script.
# See scripts/google-sheets-contact.gs for the 5-minute setup.
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXX/exec
GOOGLE_SHEETS_SECRET=the-same-long-random-string-as-in-the-script

# Option 2: email via Resend (needs perilancers.com verified in Resend).
RESEND_API_KEY=
# Optional overrides. Defaults: to work@perilancers.com, from noreply@perilancers.com.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# ─── Analytics ─────────────────────────────────────────────────────────────────
# Optional: Google Analytics 4 measurement ID. Analytics only loads when this is set.
NEXT_PUBLIC_GA_ID=
